# =============================================================================
# Curious If — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get from: https://supabase.com → Project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct DB connection (for migrations / scripts only — never use in app code)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Email Encryption
# AES-256-GCM key — 64-char hex string (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: NEVER rotate ENCRYPTION_KEY after launch (existing emails unreadable)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# HMAC-SHA256 blind index key — for subscriber email dedup lookups
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: NEVER rotate BLIND_INDEX_SECRET after launch (index becomes invalid)
BLIND_INDEX_SECRET=your_64_char_hex_blind_index_secret

# -----------------------------------------------------------------------------
# OpenAI — Content Moderation
# Used for: omni-moderation-latest on answer submissions
# Get from: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key

# -----------------------------------------------------------------------------
# Resend — Transactional Email
# Used for: subscription confirmations, answer notifications, invite emails
# Get from: https://resend.com/api-keys
# Sending domain: curiousif.blog (must be verified in Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=hello@curiousif.blog
RESEND_FROM_NAME=Curious If

# -----------------------------------------------------------------------------
# Upstash Redis — Rate Limiting
# Used for: API route rate limiting (answer submissions, subscriptions)
# Get from: https://console.upstash.com → Redis → your database → REST API
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# -----------------------------------------------------------------------------
# Site Config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://curiousif.blog
ADMIN_EMAIL=your_admin_email@gmail.com

# -----------------------------------------------------------------------------
# Plausible Analytics
# Self-hosted or cloud. Script injected via next.config
# Get from: https://plausible.io → your site → Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=curiousif.blog
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# -----------------------------------------------------------------------------
# Security / Webhook Secrets
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------

# Vercel Cron job authentication
CRON_SECRET=your_cron_secret

# ISR on-demand revalidation (called by Supabase webhooks)
REVALIDATE_SECRET=your_revalidate_secret

# Supabase webhook signing secret (Database Webhooks → your webhook → secret)
WEBHOOK_SECRET=your_webhook_secret
